# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
# Example Local: mongodb://127.0.0.1:27017/focusnest
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/focusnest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/focusnest

# Firebase Admin SDK Configuration
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: Individual environment variables from your Firebase service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Set ALLOW_DEV_AUTH=true in development to test endpoints with Bearer dev_token_<uid>
ALLOW_DEV_AUTH=true

# Google Gemini API Key (for FocusNest AI study buddy in Phase 6). Google AI Studio authorization keys can begin with AQ.
GEMINI_API_KEY=
