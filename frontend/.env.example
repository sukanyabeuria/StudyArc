# ==========================================
# StudyArc Frontend Environment Variables
# ==========================================

# Backend API Base URL
# - Local Development: http://localhost:5000/api
# - Production (Render): https://studyarc-backend.onrender.com/api
VITE_API_URL=https://studyarc-backend.onrender.com/api

# Firebase Web Client Configuration (Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# Add these in Vercel Project Settings -> Environment Variables
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
