# Root .gitignore for FocusNest

# Environment variables & secrets (CRITICAL: Never commit .env files)
.env
.env.*
!.env.example

# Credentials, keys, and certificates
*firebase*key*.json
*serviceAccountKey*.json
firebase-service-account*.json
*.pem
*.key
*.p12
*.cert

# Node dependencies & build artifacts
node_modules/
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
