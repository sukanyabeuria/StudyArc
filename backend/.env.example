# ==========================================
# FocusNest Backend Environment Configuration
# ==========================================

# Server Configuration
PORT=5000
# Set to 'production' in deployed environments
NODE_ENV=development

# Allowed Frontend Client URL(s)
# - In development: http://localhost:5173
# - In production: Replace with your deployed frontend URL (e.g. https://focusnest.vercel.app)
#   Multiple origins can be comma-separated: https://focusnest.vercel.app,https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection String)
# - Local MongoDB: mongodb://127.0.0.1:27017/focusnest
# - MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/focusnest?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/focusnest

# Firebase Admin SDK Configuration
# Option A: Path to service account JSON file (e.g., ./config/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Option B: Direct environment variables (Recommended for cloud hosting like Render/Railway)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Authentication Mock Flag
# Set ALLOW_DEV_AUTH=true ONLY during local development to test endpoints with Bearer dev_token_<uid>
# CRITICAL SECURITY: Set to false (or omit) in production!
ALLOW_DEV_AUTH=false

# Google Gemini API Key (for FocusNest AI study companion)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
